{
  "name": "webui-wasm",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build:wasm": "cargo +stable build -p ossm-wasm --target wasm32-unknown-unknown --release && wasm-bindgen --target web --out-dir src/pkg ../../../target/wasm32-unknown-unknown/release/ossm_wasm.wasm",
    "build:html": "vite build",
    "dev": "npm run build:wasm && vite",
    "build": "npm run build:wasm && npm run build:html",
    "preview": "vite preview"
  },
  "dependencies": {
    "@lucide/vue": "^1.23.0",
    "@ossm/client": "*",
    "@ossm/shared": "*",
    "@tailwindcss/vite": "^4.1.17",
    "tailwindcss": "^4.1.17",
    "vue": "^3.5.25",
    "vue-i18n": "^11.4.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/w3c-web-serial": "^1.0.8",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/tsconfig": "^0.8.1",
    "typescript": "~5.9.0",
    "vite": "^7.3.6",
    "vite-plugin-singlefile": "^2.3.0",
    "vue-tsc": "^3.1.5"
  }
}
